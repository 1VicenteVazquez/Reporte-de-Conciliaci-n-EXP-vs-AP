-- ============================================================
-- INDICADORES AGREGADOS - REPORTE CONCILIACION EXP vs AP
-- ============================================================
-- Requerimiento 1.5.6: Total conciliado, Total pendiente de
-- migracion, Total observado -- desglosado por Unidad de Negocio
-- ============================================================

WITH exp_header AS (
    SELECT
        eer.expense_report_num,
        eer.expense_report_total,
        eer.org_id
    FROM exm_expense_reports eer
),
ap_header AS (
    SELECT
        aia.invoice_num,
        aia.invoice_amount
    FROM ap_invoices_all aia
),
org_hr AS (
    SELECT organization_id, name AS org_name
    FROM   hr_all_organization_units_vl
),
detalle AS (
    SELECT
        oh.org_name AS unidad_negocio,
        CASE
            WHEN ah.invoice_num IS NULL THEN 'PENDIENTE DE MIGRACION'
            WHEN ABS(eh.expense_report_total - ah.invoice_amount) > 0.01
                 THEN 'OBSERVADO - DIFERENCIA DE VALOR'
            ELSE 'CONCILIADO'
        END AS indicador
    FROM exp_header eh, ap_header ah, org_hr oh
    WHERE  ah.invoice_num (+)      = eh.expense_report_num
    AND    oh.organization_id (+)  = eh.org_id
    AND    oh.org_name IN ('ARCAF','CLID','PEBPE','PYBPY','UYBUY')
)
SELECT
    unidad_negocio,
    indicador,
    COUNT(*) AS cantidad
FROM detalle
GROUP BY unidad_negocio, indicador
ORDER BY unidad_negocio, indicador