-- ============================================================
-- DATA SET 2: INDICADORES AGREGADOS (KPIs) - V2 (Corregido)
-- ============================================================
-- Requerimiento: AN100.2 - Grupo Bimbo (Expenses)
-- KPIs solicitados: Total conciliado, Total pendiente de migración, Total observado
-- ============================================================

WITH exp_header AS (
    SELECT
        eer.expense_report_num,
        eer.expense_report_total,
        eer.expense_status_code,
        eer.expense_report_date,
        eer.org_id
    FROM exm_expense_reports eer
),
ap_header AS (
    SELECT
        aia.invoice_num,
        aia.invoice_amount,
        aia.gl_date,
        aia.amount_paid
    FROM ap_invoices_all aia
),
org_hr AS (
    SELECT organization_id, name AS org_name
    FROM hr_all_organization_units_vl
),
base_datos AS (
    SELECT
        oh.org_name AS unidad_negocio,
        eh.expense_report_total AS monto_expenses,
        NVL(ah.amount_paid, 0) AS importe_pagado_ap,
        (NVL(ah.invoice_amount, 0) - NVL(ah.amount_paid, 0)) AS importe_pendiente_ap,
        CASE
            WHEN eh.expense_status_code LIKE '%REJECT%' OR eh.expense_status_code = 'RETURNED' 
                 THEN 'OBSERVADO'
            WHEN ah.invoice_num IS NOT NULL AND NVL(ah.amount_paid, 0) = 0 AND ABS(eh.expense_report_total - NVL(ah.invoice_amount,0)) > 0.01 
                 THEN 'OBSERVADO'
            WHEN ah.invoice_num IS NOT NULL AND ABS(eh.expense_report_total - ah.invoice_amount) > 0.01 
                 THEN 'OBSERVADO'
            WHEN ah.invoice_num IS NOT NULL AND ah.gl_date IS NOT NULL 
                 THEN 'CONCILIADO'
            WHEN eh.expense_status_code IN ('READY_FOR_PAYMENT', 'APPROVED', 'PENDING_PAYMENT') OR (ah.invoice_num IS NOT NULL AND ah.gl_date IS NULL) 
                 THEN 'PENDIENTE DE MIGRACION'
            ELSE 'PENDIENTE DE MIGRACION'
        END AS resultado_conciliacion
    FROM exp_header eh, ap_header ah, org_hr oh
    WHERE ah.invoice_num (+)      = eh.expense_report_num
    AND   oh.organization_id (+)  = eh.org_id
    AND   oh.org_name IN ('ARCAF','CLID','PEBPE','PYBPY','UYBUY')
    AND   oh.org_name = NVL(:P_UNIDAD_NEGOCIO, oh.org_name)
    AND   TRUNC(eh.expense_report_date) >= NVL(:P_FECHA_DESDE, TRUNC(eh.expense_report_date))
    AND   TRUNC(eh.expense_report_date) <= NVL(:P_FECHA_HASTA, TRUNC(eh.expense_report_date))
)
SELECT 
    unidad_negocio                        AS unidad_negocio, 
    resultado_conciliacion                AS indicador_resumen, 
    COUNT(*)                              AS cantidad_documentos, 
    SUM(monto_expenses)                   AS monto_total_expenses,
    SUM(importe_pagado_ap)                AS monto_total_pagado_ap,
    SUM(importe_pendiente_ap)             AS monto_total_pendiente_ap,
    'PENDIENTE VALIDAR MONEDA (TEMA 11)'  AS nota_moneda
FROM base_datos 
WHERE resultado_conciliacion = NVL(:P_RESULTADO_CONCILIACION, resultado_conciliacion)
GROUP BY unidad_negocio, resultado_conciliacion
ORDER BY unidad_negocio, resultado_conciliacion