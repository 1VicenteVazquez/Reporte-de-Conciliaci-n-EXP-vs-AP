-- ============================================================
-- REPORTE DE CONCILIACION EXPENSES vs AP - REGION LAS
-- ============================================================
-- Requerimiento 1.5.6 (AN100 Grupo Bimbo - Expenses)
-- REPORTE DE CONCILIACION EXPENSES vs AP - REGION LAS (v8)
-- ============================================================

WITH proveedor_por_factura AS (
    SELECT
        ail.invoice_id,
        ail.merchant_name,
        ROW_NUMBER() OVER (
            PARTITION BY ail.invoice_id
            ORDER BY ail.amount DESC NULLS LAST
        ) AS rn
    FROM ap_invoice_lines_all ail
    WHERE ail.merchant_name IS NOT NULL
)
SELECT
    eh.expense_report_num,
    eh.expense_status_code                              AS estado_expenses,
    TO_CHAR(eh.expense_report_date, 'DD/MM/YYYY')        AS fecha_expenses,
    eh.expense_report_total                             AS monto_expenses,
    eh.reimbursement_currency_code                      AS moneda_expenses,
    co.full_name                                        AS colaborador,
    oh.name                                             AS unidad_negocio,
    mf.currency_code                                    AS moneda_funcional,
    ah.invoice_num,
    TO_CHAR(ah.invoice_date, 'DD/MM/YYYY')               AS fecha_ap,
    ah.invoice_amount                                   AS monto_ap,
    ah.invoice_currency_code                            AS moneda_ap,
    NVL(pf.merchant_name, 'Proveedor no identificado')  AS proveedor,
    NVL(ah.total_tax_amount, 0)                         AS impuesto_ap,
    ah.approval_status                                  AS estado_aprobacion_ap,
    ah.amount_paid                                      AS importe_pagado,
    CASE
        WHEN ah.gl_date IS NOT NULL THEN 'CONTABILIZADO'
        WHEN ah.invoice_num IS NOT NULL THEN 'PENDIENTE DE CONTABILIZACION'
        ELSE NULL
    END                                                 AS estado_contabilizacion_ap,
    (eh.expense_report_total - NVL(ah.invoice_amount,0)) AS diferencia_valor,

    -- INDICADOR DETALLADO (6 ESTADOS)
    CASE
        WHEN eh.expense_status_code LIKE '%REJECT%' OR eh.expense_status_code = 'RETURNED'
             THEN 'RECHAZADO'
        -- hay diferencia, pero no hubo pago real -> NO PAGADA
        WHEN ah.invoice_num IS NOT NULL
             AND NVL(ah.amount_paid, 0) = 0
             AND ABS(eh.expense_report_total - NVL(ah.invoice_amount,0)) > 0.01
             THEN 'NO PAGADA'
        WHEN ah.invoice_num IS NOT NULL AND ABS(eh.expense_report_total - ah.invoice_amount) > 0.01
             THEN 'CON DIFERENCIAS'
        WHEN ah.invoice_num IS NOT NULL AND ah.gl_date IS NOT NULL
             THEN 'CONTABILIZADO'
        WHEN eh.expense_status_code IN ('READY_FOR_PAYMENT', 'APPROVED', 'PENDING_PAYMENT')
          OR (ah.invoice_num IS NOT NULL AND ah.gl_date IS NULL)
             THEN 'APROBADO'
        ELSE 'ENVIADO'
    END                                                 AS indicador_conciliacion,

    -- INDICADOR RESUMEN 
    
    CASE
        WHEN eh.expense_status_code LIKE '%REJECT%' OR eh.expense_status_code = 'RETURNED'
             THEN 'Total observado'
        WHEN ah.invoice_num IS NOT NULL
             AND NVL(ah.amount_paid, 0) = 0
             AND ABS(eh.expense_report_total - NVL(ah.invoice_amount,0)) > 0.01
             THEN 'Total observado'
        WHEN ah.invoice_num IS NOT NULL AND ABS(eh.expense_report_total - ah.invoice_amount) > 0.01
             THEN 'Total observado'
        WHEN ah.invoice_num IS NOT NULL AND ah.gl_date IS NOT NULL
             THEN 'Total conciliado'
        ELSE 'Total pendiente de migración'
    END                                                 AS indicador_resumen

FROM
    exm_expense_reports eh,
    ap_invoices_all ah,
    proveedor_por_factura pf,
    per_person_names_f co,
    hr_all_organization_units_vl oh,
    fun_all_business_units_v bu,
    gl_ledgers mf
WHERE
    eh.expense_report_num = ah.invoice_num(+)
    AND ah.invoice_id = pf.invoice_id(+) AND pf.rn(+) = 1
    AND eh.person_id = co.person_id(+)
    AND co.name_type(+) = 'GLOBAL'
    AND TRUNC(SYSDATE) BETWEEN co.effective_start_date(+) AND co.effective_end_date(+)
    AND eh.org_id = oh.organization_id
    AND oh.name = bu.bu_name(+)
    AND TO_NUMBER(bu.primary_ledger_id) = mf.ledger_id(+)

    AND oh.name IN ('ARCAF','CLID','PEBPE','PYBPY','UYBUY')

    AND oh.name = NVL(:P_UNIDAD_NEGOCIO, oh.name)
    AND TRUNC(eh.expense_report_date) >= NVL(:P_FECHA_DESDE, TRUNC(eh.expense_report_date))
    AND TRUNC(eh.expense_report_date) <= NVL(:P_FECHA_HASTA, TRUNC(eh.expense_report_date))

    -- PARAMETRO DE INDICADOR 
    AND (
        CASE
            WHEN eh.expense_status_code LIKE '%REJECT%' OR eh.expense_status_code = 'RETURNED' THEN 'RECHAZADO'
            WHEN ah.invoice_num IS NOT NULL AND NVL(ah.amount_paid, 0) = 0 AND ABS(eh.expense_report_total - NVL(ah.invoice_amount,0)) > 0.01 THEN 'NO PAGADA'
            WHEN ah.invoice_num IS NOT NULL AND ABS(eh.expense_report_total - ah.invoice_amount) > 0.01 THEN 'CON DIFERENCIAS'
            WHEN ah.invoice_num IS NOT NULL AND ah.gl_date IS NOT NULL THEN 'CONTABILIZADO'
            WHEN eh.expense_status_code IN ('READY_FOR_PAYMENT', 'APPROVED', 'PENDING_PAYMENT') OR (ah.invoice_num IS NOT NULL AND ah.gl_date IS NULL) THEN 'APROBADO'
            ELSE 'ENVIADO'
        END
    ) = NVL(:P_INDICADOR,
        CASE
            WHEN eh.expense_status_code LIKE '%REJECT%' OR eh.expense_status_code = 'RETURNED' THEN 'RECHAZADO'
            WHEN ah.invoice_num IS NOT NULL AND NVL(ah.amount_paid, 0) = 0 AND ABS(eh.expense_report_total - NVL(ah.invoice_amount,0)) > 0.01 THEN 'NO PAGADA'
            WHEN ah.invoice_num IS NOT NULL AND ABS(eh.expense_report_total - ah.invoice_amount) > 0.01 THEN 'CON DIFERENCIAS'
            WHEN ah.invoice_num IS NOT NULL AND ah.gl_date IS NOT NULL THEN 'CONTABILIZADO'
            WHEN eh.expense_status_code IN ('READY_FOR_PAYMENT', 'APPROVED', 'PENDING_PAYMENT') OR (ah.invoice_num IS NOT NULL AND ah.gl_date IS NULL) THEN 'APROBADO'
            ELSE 'ENVIADO'
        END
    )