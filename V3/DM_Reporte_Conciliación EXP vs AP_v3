--------------------------------------------------------------------------------
-- Reporte de Conciliación EXPENSES vs AP - v4
--------------------------------------------------------------------------------

WITH PROVEEDOR_POR_FACTURA AS (
    SELECT
         AILA.INVOICE_ID
        ,AILA.MERCHANT_NAME
        ,ROW_NUMBER() OVER (
            PARTITION BY AILA.INVOICE_ID
            ORDER BY AILA.AMOUNT DESC NULLS LAST
        ) AS RN
    FROM 
        AP_INVOICE_LINES_ALL                               AILA
    WHERE 
        AILA.MERCHANT_NAME IS NOT NULL
)
,CUENTA_CONTABLE_POR_GASTO AS (
    SELECT
         EED.EXPENSE_ID
        ,EED.CODE_COMBINATION_ID
        ,GCC.SEGMENT1 || '.' || GCC.SEGMENT2 || '.' || GCC.SEGMENT3 || '.' || GCC.SEGMENT4 
                                                                   COMBINACION_CONTABLE_EXP_TXT
        ,ROW_NUMBER() OVER (
            PARTITION BY EED.EXPENSE_ID
            ORDER BY EED.REIMBURSABLE_AMOUNT DESC NULLS LAST
        ) AS RN
    FROM 
        EXM_EXPENSE_DISTS                                   EED
        ,GL_CODE_COMBINATIONS                               GCC
    WHERE
        EED.CODE_COMBINATION_ID = GCC.CODE_COMBINATION_ID(+)
)
,ADELANTOS_POR_INFORME AS (
    SELECT
         ECAA.EXPENSE_REPORT_ID
        ,SUM(ECAA.AMOUNT) AS                                 TOTAL_ADELANTO_APLICADO
    FROM 
        EXM_CASH_ADV_APPLICATIONS ECAA
    GROUP BY 
        ECAA.EXPENSE_REPORT_ID
)
,LINEAS_PADRE_EXCLUIR AS (
    SELECT DISTINCT ITEMIZATION_PARENT_EXPENSE_ID       EXPENSE_ID_PADRE
    FROM EXM_EXPENSES
    WHERE ITEMIZATION_PARENT_EXPENSE_ID IS NOT NULL
      AND ITEMIZATION_PARENT_EXPENSE_ID != -1
    UNION
    SELECT DISTINCT MERGED_PARENT_EXPENSE_ID            EXPENSE_ID_PADRE
    FROM EXM_EXPENSES
    WHERE MERGED_PARENT_EXPENSE_ID IS NOT NULL
      AND MERGED_PARENT_EXPENSE_ID != -1
)
,DISTRIBUCIONES_AP AS (
    SELECT
         AID.INVOICE_ID
        ,AID.INVOICE_LINE_NUMBER
        ,AID.DIST_CODE_COMBINATION_ID
        ,GCC.CONCATENATED_SEGMENTS                          COMBINACION_CONTABLE_AP_TXT
        ,AID.TAX_CODE_ID
        ,AID.AMOUNT                                         TAX_AMOUNT
        ,AID.LINE_TYPE_LOOKUP_CODE
    FROM
         AP_INVOICE_DISTRIBUTIONS_ALL                       AID
        ,GL_CODE_COMBINATIONS                               GCC
    WHERE
         AID.DIST_CODE_COMBINATION_ID = GCC.CODE_COMBINATION_ID(+)
        AND AID.LINE_TYPE_LOOKUP_CODE IN ('REC_TAX', 'NONREC_TAX')
)
,IMPUESTOS_AP AS (
    SELECT
        TRX_ID,
        TRX_LINE_NUMBER,
        MAX(TAX) AS TAX_CODE,
        SUM(TAX_AMT) AS TOTAL_TAX_AMOUNT_REAL,
        SUM(TAX_AMT_FUNCL_CURR) AS TOTAL_TAX_AMOUNT_FUNCL
    FROM ZX_LINES
    WHERE APPLICATION_ID = 200 
      AND ENTITY_CODE = 'AP_INVOICES'
    GROUP BY TRX_ID, TRX_LINE_NUMBER
)
,IMPUESTOS_AP_AGREGADOS AS (
    SELECT
         TRX_ID
        ,MAX(TAX_CODE) AS TAX_CODE_ID
        ,SUM(TOTAL_TAX_AMOUNT_REAL) AS TOTAL_TAX_AMOUNT_REAL
    FROM
        IMPUESTOS_AP
    GROUP BY
        TRX_ID
)
,BASE_DATOS AS (
    SELECT
         XEP.NAME                                          RAZON_SOCIAL              
        ,HAOUV.NAME                                        UNIDAD_NEGOCIO            
        ,PPNF.FULL_NAME                                    NOMBRE_DEL_EMPLEADO       
        ,EER.EXPENSE_REPORT_NUM                            NUM_INFORME_DE_GASTOS     
        ,EER.EXPENSE_STATUS_CODE                           ESTADO_DEL_INFORME        
        ,TO_CHAR(EER.FINAL_APPROVAL_DATE, 'DD/MM/YYYY')    FECHA_DE_CREACION         
        ,ROW_NUMBER() OVER (
            PARTITION BY EE.EXPENSE_REPORT_ID 
            ORDER BY EE.EXPENSE_ID
        )                                                  LINEA_DE_GASTO            
        ,TO_CHAR(COALESCE(EE.RECEIPT_DATE, EE.START_DATE), 'DD/MM/YYYY')            
                                                           FECHA_DEL_GASTO_LINEA     
        ,ET.NAME                                           TIPO_DE_GASTO             
        ,EE.DESCRIPTION                                    DESCRIPCION_DEL_GASTO    
        ,NVL(PPF.MERCHANT_NAME, 'PROVEEDOR NO IDENTIFICADO') 
                                                           NOMBRE_COMERCIANTE_PROVEEDOR_EXP  
        ,AIA.INVOICE_NUM                                   NUMERO_DE_FACTURA_AP      
        ,PS.VENDOR_NAME                                    PROVEEDOR_AP              
        ,AIA.APPROVAL_STATUS                               ESTADO_FACTURA_AP         
        ,TO_CHAR(AIA.INVOICE_DATE, 'DD/MM/YYYY')           FECHA_FACTURA_AP          
        ,TO_CHAR(AIA.GL_DATE, 'DD/MM/YYYY')                FECHA_CONTABLE_AP        
        ,EER.REIMBURSEMENT_CURRENCY_CODE                   MONEDA_INTRODUCIDA_EXP    
        ,EER.EXPENSE_REPORT_TOTAL                          IMPORTE_EXP_MONEDA_INTRODUCIDA
        ,AIA.INVOICE_AMOUNT                                IMPORTE_AP_MONEDA_INTRODUCIDA 
        ,(EER.EXPENSE_REPORT_TOTAL - NVL(AIA.INVOICE_AMOUNT,0)) 
                                                           DIFERENCIA_MONEDA_INTRODUCIDA 
        ,EE.EXCHANGE_RATE                                  TIPO_DE_CAMBIO            
        ,GL.CURRENCY_CODE                                  MONEDA_FUNCIONAL          
        ,EER.EXPENSE_REPORT_TOTAL * NVL(EE.EXCHANGE_RATE,1) 
                                                           IMPORTE_EXP_MONEDA_FUNCIONAL  
        ,AIA.INVOICE_AMOUNT * NVL(AIA.EXCHANGE_RATE,1)     IMPORTE_AP_MONEDA_FUNCIONAL   
        ,(EER.EXPENSE_REPORT_TOTAL * NVL(EE.EXCHANGE_RATE,1) 
         - AIA.INVOICE_AMOUNT * NVL(AIA.EXCHANGE_RATE,1)) 
                                                           DIFERENCIA_MONEDA_FUNCIONAL   
        ,EE.TAX_CLASSIFICATION_CODE                        CODIGO_DE_IMPUESTO_EXP    
        ,CAST(NULL AS NUMBER)                              IMPORTE_IMPUESTO_EXP      
        ,IAP.TAX_CODE_ID                                   CODIGO_DE_IMPUESTO_AP     
        ,NVL(IAP.TOTAL_TAX_AMOUNT_REAL, 0)                 IMPORTE_IMPUESTO_AP       
        ,(NVL(0, 0) - NVL(IAP.TOTAL_TAX_AMOUNT_REAL, 0))   DIFERENCIA_IMPUESTO       
        ,CCPG.COMBINACION_CONTABLE_EXP_TXT                 COMBINACION_CONTABLE_EXP 
        ,DAP.COMBINACION_CONTABLE_AP_TXT                   COMBINACION_CONTABLE_AP   
        ,CASE 
            WHEN CCPG.CODE_COMBINATION_ID IS NOT NULL 
             AND DAP.DIST_CODE_COMBINATION_ID IS NOT NULL 
             AND CCPG.CODE_COMBINATION_ID != DAP.DIST_CODE_COMBINATION_ID 
            THEN 'DIFERENTE'
            WHEN CCPG.CODE_COMBINATION_ID IS NOT NULL 
             AND DAP.DIST_CODE_COMBINATION_ID IS NULL 
            THEN 'SIN_CUENTA_AP'
            WHEN CCPG.CODE_COMBINATION_ID IS NULL 
             AND DAP.DIST_CODE_COMBINATION_ID IS NOT NULL 
            THEN 'SIN_CUENTA_EXP'
            ELSE 'IGUAL'
         END                                               DIFERENCIA_CUENTA_CONTABLE   
    FROM
         EXM_EXPENSE_REPORTS                           EER
        ,EXM_EXPENSES                                  EE
        ,AP_INVOICES_ALL                               AIA
        ,AP_INVOICE_LINES_ALL                          APIL
        ,PROVEEDOR_POR_FACTURA                         PPF
        ,CUENTA_CONTABLE_POR_GASTO                     CCPG
        ,ADELANTOS_POR_INFORME                         API
        ,PER_PERSON_NAMES_F                            PPNF
        ,PER_ALL_PEOPLE_F                              PAPF
        ,HR_ALL_ORGANIZATION_UNITS_VL                  HAOUV
        ,FUN_ALL_BUSINESS_UNITS_V                      FABUV
        ,XLE_ENTITY_PROFILES                           XEP
        ,GL_LEDGERS                                    GL
        ,EXM_EXPENSE_TYPES                             ET
        ,POZ_SUPPLIERS_V                               PS
        ,DISTRIBUCIONES_AP                             DAP
        ,IMPUESTOS_AP_AGREGADOS                        IAP
    WHERE
        EER.EXPENSE_REPORT_NUM = AIA.INVOICE_NUM(+)
        AND EER.EXPENSE_REPORT_ID = EE.EXPENSE_REPORT_ID
        AND EE.EXPENSE_ID NOT IN (
            SELECT EXPENSE_ID_PADRE 
            FROM LINEAS_PADRE_EXCLUIR
        )
        AND AIA.INVOICE_ID = APIL.INVOICE_ID(+)
        AND APIL.REFERENCE_KEY2(+) = EE.EXPENSE_ID
        AND AIA.INVOICE_ID = PPF.INVOICE_ID(+) 
        AND PPF.RN(+) = 1
        AND EE.EXPENSE_ID = CCPG.EXPENSE_ID(+) 
        AND CCPG.RN(+) = 1
        AND EER.EXPENSE_REPORT_ID = API.EXPENSE_REPORT_ID(+)
        AND EER.PERSON_ID = PPNF.PERSON_ID(+)
        AND PPNF.NAME_TYPE(+) = 'GLOBAL'
        AND TRUNC(SYSDATE) BETWEEN PPNF.EFFECTIVE_START_DATE(+) 
        AND PPNF.EFFECTIVE_END_DATE(+)
        AND EER.PERSON_ID = PAPF.PERSON_ID(+)                                                                                                                                 
        AND TRUNC(SYSDATE) BETWEEN PAPF.EFFECTIVE_START_DATE(+) 
        AND PAPF.EFFECTIVE_END_DATE(+) 
        AND EER.ORG_ID = HAOUV.ORGANIZATION_ID
        AND HAOUV.NAME = FABUV.BU_NAME(+)
        AND TO_NUMBER(FABUV.PRIMARY_LEDGER_ID) = GL.LEDGER_ID(+)
        AND TO_NUMBER(FABUV.LEGAL_ENTITY_ID) = XEP.LEGAL_ENTITY_ID(+)                                                                                                                                 
        AND TRUNC(SYSDATE) BETWEEN NVL(XEP.EFFECTIVE_FROM(+), TO_DATE('01/01/1900','DD/MM/YYYY')) 
                                AND NVL(XEP.EFFECTIVE_TO(+), TO_DATE('31/12/4712','DD/MM/YYYY'))      
        AND HAOUV.NAME IN ('ARCAF','CLID','PEBPE','PYBPY','UYBUY')
        -- Parámetro Oficial: Razón Social (multiple selection corregido)
        AND ( LEAST(:P_RAZON_SOCIAL) IS NULL OR XEP.NAME IN (:P_RAZON_SOCIAL) )
        -- Parámetro Oficial: Unidad de Negocio (multiple selection corregido)
        AND ( LEAST(:P_UNIDAD_NEGOCIO) IS NULL OR HAOUV.NAME IN (:P_UNIDAD_NEGOCIO) )
        -- Parámetros Oficiales: Fechas Desde / Hasta
        AND TRUNC(EER.EXPENSE_REPORT_DATE) >= NVL(:P_FECHA_DESDE, TRUNC(EER.EXPENSE_REPORT_DATE))
        AND TRUNC(EER.EXPENSE_REPORT_DATE) <= NVL(:P_FECHA_HASTA, TRUNC(EER.EXPENSE_REPORT_DATE))
        -- Parámetro Oficial: Número de Informe de Gastos
        AND (EER.EXPENSE_REPORT_NUM = NVL(:P_NUM_INFORME, EER.EXPENSE_REPORT_NUM) OR :P_NUM_INFORME IS NULL)
        -- Parámetro Oficial: Nombre del Empleado (ID)
        AND EER.PERSON_ID = NVL(:P_COLABORADOR_ID, EER.PERSON_ID) 
        -- Parámetro Oficial: Estado Expense
        AND EER.EXPENSE_STATUS_CODE = NVL(:P_ESTADO_EXPENSES, EER.EXPENSE_STATUS_CODE)
        -- Parámetro Oficial: Estado AP
        AND (AIA.APPROVAL_STATUS = NVL(:P_ESTADO_AP, AIA.APPROVAL_STATUS) OR (:P_ESTADO_AP IS NULL AND AIA.APPROVAL_STATUS IS NULL))
        -- Parámetro Oficial: Cuenta Contable
        AND (CCPG.CODE_COMBINATION_ID = NVL(
                CASE WHEN REGEXP_LIKE(:P_CUENTA_CONTABLE, '^[0-9]+$') 
                    THEN TO_NUMBER(:P_CUENTA_CONTABLE) 
                END, 
                CCPG.CODE_COMBINATION_ID)
            OR :P_CUENTA_CONTABLE IS NULL)
        -- Joins complementarios de tipos y proveedores
        AND EE.EXPENSE_TYPE_ID = ET.EXPENSE_TYPE_ID(+)
        AND AIA.VENDOR_ID = PS.VENDOR_ID(+)
        AND AIA.INVOICE_ID = DAP.INVOICE_ID(+)
        AND DAP.INVOICE_LINE_NUMBER(+) = 1
        AND AIA.INVOICE_ID = IAP.TRX_ID(+)
)
SELECT * 
FROM BASE_DATOS