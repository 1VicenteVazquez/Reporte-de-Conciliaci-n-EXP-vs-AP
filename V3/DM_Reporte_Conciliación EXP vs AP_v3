WITH TASAS_IMPUESTO_EXP AS (
    SELECT 'UY_IVA_10_AP' TAX_CLASSIFICATION_CODE, 10 TASA, 'Y' IMPUESTO_INCLUIDO FROM DUAL UNION ALL
    SELECT 'UY_IVA_22_AP', 22, 'Y' FROM DUAL UNION ALL
    SELECT 'UY_IVA_EXENTO_AP', 0, 'Y' FROM DUAL UNION ALL
    SELECT 'UY_IVA_NO AFECTO_AP', 0, 'Y' FROM DUAL UNION ALL
    SELECT 'PE_GRAVADO_10_IG', 10, 'Y' FROM DUAL UNION ALL
    SELECT 'PE_GRAVADO_IG', 18, 'Y' FROM DUAL UNION ALL
    SELECT 'PE_GRAVADO_8_IG', 8, 'Y' FROM DUAL UNION ALL
    SELECT 'PE_GRAVADO_10.5_IG', 10.5, 'Y' FROM DUAL UNION ALL
    SELECT 'PE_GRAVADO_15_IG', 15, 'Y' FROM DUAL UNION ALL
    SELECT 'PE_RET_4TA', -8, 'Y' FROM DUAL UNION ALL
    SELECT 'PY_IVA_10%_EXP_AP', 10, 'Y' FROM DUAL UNION ALL
    SELECT 'PY_IVA_5%_EXP_AP', 5, 'Y' FROM DUAL UNION ALL
    SELECT 'PY_IVA_EXENTO_AP', 0, 'Y' FROM DUAL UNION ALL
    SELECT 'CL_IVA_12%_AP', 12, 'Y' FROM DUAL UNION ALL
    SELECT 'CL_IVA_12%_GPO_AP', 12, 'Y' FROM DUAL UNION ALL
    SELECT 'CL_IVA_19%_AP', 19, 'Y' FROM DUAL UNION ALL
    SELECT 'CL_IVA_EXENTO_AP', 0, 'Y' FROM DUAL UNION ALL
    SELECT 'CL_IVA_IMP_19%_AP', 19, 'Y' FROM DUAL UNION ALL
    SELECT 'CL_IVA_NO_AFECTO_AP', 0, 'Y' FROM DUAL UNION ALL
    SELECT 'CL_IVA_AP', 19, 'Y' FROM DUAL UNION ALL
    SELECT 'CL_IVA_AP_GRP', 12, 'Y' FROM DUAL
),
ESTADOS_EXPENSE_LOOKUP AS (
    SELECT DISTINCT LOOKUP_CODE, MEANING
    FROM FND_LOOKUP_VALUES_VL
    WHERE LOOKUP_TYPE = 'EXM_REPORT_STATUS'
),
ESTADOS_AP_LOOKUP AS (
    SELECT DISTINCT LOOKUP_CODE, MEANING
    FROM FND_LOOKUP_VALUES_VL
    WHERE LOOKUP_TYPE IN ('INVOICE STATUS', 'AP_INVOICE_STATUS')
),
PROVEEDOR_POR_FACTURA AS (
    SELECT AILA.INVOICE_ID, AILA.MERCHANT_NAME,
           ROW_NUMBER() OVER (PARTITION BY AILA.INVOICE_ID ORDER BY AILA.AMOUNT DESC NULLS LAST) AS RN
    FROM AP_INVOICE_LINES_ALL AILA
    WHERE AILA.MERCHANT_NAME IS NOT NULL
),
CUENTA_CONTABLE_POR_GASTO AS (
    SELECT EED.EXPENSE_ID, EED.CODE_COMBINATION_ID,
           GCC.CONCATENATED_SEGMENTS COMBINACION_CONTABLE_EXP_TXT,
           ROW_NUMBER() OVER (PARTITION BY EED.EXPENSE_ID ORDER BY EED.REIMBURSABLE_AMOUNT DESC NULLS LAST) AS RN
    FROM EXM_EXPENSE_DISTS EED, GL_CODE_COMBINATIONS GCC
    WHERE EED.CODE_COMBINATION_ID = GCC.CODE_COMBINATION_ID(+)
),
LINEAS_PADRE_EXCLUIR AS (
    SELECT DISTINCT ITEMIZATION_PARENT_EXPENSE_ID EXPENSE_ID_PADRE
    FROM EXM_EXPENSES
    WHERE ITEMIZATION_PARENT_EXPENSE_ID IS NOT NULL AND ITEMIZATION_PARENT_EXPENSE_ID != -1
    UNION
    SELECT DISTINCT MERGED_PARENT_EXPENSE_ID EXPENSE_ID_PADRE
    FROM EXM_EXPENSES
    WHERE MERGED_PARENT_EXPENSE_ID IS NOT NULL AND MERGED_PARENT_EXPENSE_ID != -1
),
DISTRIBUCIONES_AP AS (
    SELECT AID.INVOICE_ID, AID.INVOICE_LINE_NUMBER, AID.DIST_CODE_COMBINATION_ID,
           GCC.CONCATENATED_SEGMENTS COMBINACION_CONTABLE_AP_TXT,
           ROW_NUMBER() OVER (PARTITION BY AID.INVOICE_ID, AID.INVOICE_LINE_NUMBER
                              ORDER BY AID.AMOUNT DESC NULLS LAST) AS RN
    FROM AP_INVOICE_DISTRIBUTIONS_ALL AID, GL_CODE_COMBINATIONS GCC
    WHERE AID.DIST_CODE_COMBINATION_ID = GCC.CODE_COMBINATION_ID(+)
      AND AID.LINE_TYPE_LOOKUP_CODE = 'ITEM'
),
BASE_DATOS AS (
    SELECT
         XEP.NAME                                  RAZON_SOCIAL
        ,HAOUV.NAME                                UNIDAD_NEGOCIO
        ,PPNF.FULL_NAME                            NOMBRE_DEL_EMPLEADO
        ,EER.EXPENSE_REPORT_NUM                    NUM_INFORME_DE_GASTOS
        ,EER.EXPENSE_STATUS_CODE                   ESTADO_DEL_INFORME
        ,EXL.MEANING                               ESTADO_DEL_INFORME_TXT
        ,TO_CHAR(EER.FINAL_APPROVAL_DATE, 'DD/MM/YYYY')    FECHA_DE_CREACION
        ,ROW_NUMBER() OVER (PARTITION BY EE.EXPENSE_REPORT_ID ORDER BY EE.EXPENSE_ID) LINEA_DE_GASTO
        ,TO_CHAR(COALESCE(EE.RECEIPT_DATE, EE.START_DATE), 'DD/MM/YYYY') FECHA_DEL_GASTO_LINEA
        ,ET.NAME                                   TIPO_DE_GASTO
        ,ET.NAME                                   TIPO_DE_GASTO_TXT
        ,EE.DESCRIPTION                            DESCRIPCION_DEL_GASTO
        ,NVL(APIL.MERCHANT_NAME, NVL(PPF.MERCHANT_NAME, 'PROVEEDOR NO IDENTIFICADO')) NOMBRE_COMERCIANTE_PROVEEDOR_EXP
        ,AIA.INVOICE_NUM                           NUMERO_DE_FACTURA_AP
        ,HZP.PARTY_NAME                            PROVEEDOR_AP
        ,AIA.APPROVAL_STATUS                       ESTADO_FACTURA_AP
        ,APL.MEANING                               ESTADO_FACTURA_AP_TXT
        ,TO_CHAR(AIA.INVOICE_DATE, 'DD/MM/YYYY')   FECHA_FACTURA_AP
        ,TO_CHAR(AIA.GL_DATE, 'DD/MM/YYYY')        FECHA_CONTABLE_AP
        ,EER.REIMBURSEMENT_CURRENCY_CODE           MONEDA_INTRODUCIDA_EXP

        -- === IMPORTE TOTAL EXP (moneda introducida) ===
        ,ROUND(EE.REIMBURSABLE_AMOUNT, 2) AS IMPORTE_TOTAL_EXP_MONEDA_INTRODUCIDA

        -- === IMPORTE IMPUESTO EXP ===
        ,CASE
            WHEN TIE.TASA IS NULL THEN NULL
            WHEN TIE.IMPUESTO_INCLUIDO = 'Y' THEN
                 ROUND(EE.REIMBURSABLE_AMOUNT * TIE.TASA / (100 + TIE.TASA), 2)
            ELSE
                 ROUND(EE.REIMBURSABLE_AMOUNT * TIE.TASA / 100, 2)
         END AS IMPORTE_IMPUESTO_EXP

        -- === SUBTOTAL EXP (total - impuesto, moneda introducida) ===
        ,ROUND(EE.REIMBURSABLE_AMOUNT, 2)
         -
         CASE
            WHEN TIE.TASA IS NULL THEN 0
            WHEN TIE.IMPUESTO_INCLUIDO = 'Y' THEN
                 ROUND(EE.REIMBURSABLE_AMOUNT * TIE.TASA / (100 + TIE.TASA), 2)
            ELSE
                 ROUND(EE.REIMBURSABLE_AMOUNT * TIE.TASA / 100, 2)
         END AS SUBTOTAL_EXP_MONEDA_INTRODUCIDA

        -- === IMPORTE TOTAL AP (moneda introducida) ===
        ,ROUND(APIL.AMOUNT, 2) AS IMPORTE_TOTAL_AP_MONEDA_INTRODUCIDA

        -- === IMPORTE IMPUESTO AP ===
        ,ROUND(NVL((
            SELECT SUM(ZXL.TAX_AMT)
            FROM   ZX_LINES ZXL
            WHERE  ZXL.APPLICATION_ID = 200
              AND  ZXL.ENTITY_CODE = 'AP_INVOICES'
              AND  ZXL.TRX_ID = APIL.INVOICE_ID
              AND  ZXL.TRX_LINE_NUMBER = APIL.LINE_NUMBER
         ), 0), 2) AS IMPORTE_IMPUESTO_AP

        -- === SUBTOTAL AP (total - impuesto, moneda introducida) ===
        ,ROUND(APIL.AMOUNT, 2)
         -
         ROUND(NVL((
            SELECT SUM(ZXL.TAX_AMT)
            FROM   ZX_LINES ZXL
            WHERE  ZXL.APPLICATION_ID = 200
              AND  ZXL.ENTITY_CODE = 'AP_INVOICES'
              AND  ZXL.TRX_ID = APIL.INVOICE_ID
              AND  ZXL.TRX_LINE_NUMBER = APIL.LINE_NUMBER
         ), 0), 2) AS SUBTOTAL_AP_MONEDA_INTRODUCIDA

        -- === DIFERENCIA MONEDA INTRODUCIDA (entre totales) ===
        ,ROUND(EE.REIMBURSABLE_AMOUNT - NVL(APIL.AMOUNT, 0), 2) AS DIFERENCIA_MONEDA_INTRODUCIDA

        ,EE.EXCHANGE_RATE                          TIPO_DE_CAMBIO
        ,GL.CURRENCY_CODE                          MONEDA_FUNCIONAL

        -- === IMPORTE TOTAL EXP MONEDA FUNCIONAL ===
        ,ROUND(EE.REIMBURSABLE_AMOUNT * NVL(EE.EXCHANGE_RATE, 1), 2) AS IMPORTE_TOTAL_EXP_MONEDA_FUNCIONAL

        -- === IMPORTE TOTAL AP MONEDA FUNCIONAL ===
        ,ROUND(APIL.AMOUNT * NVL(AIA.EXCHANGE_RATE, 1), 2) AS IMPORTE_TOTAL_AP_MONEDA_FUNCIONAL

        -- === DIFERENCIA MONEDA FUNCIONAL ===
        ,ROUND(
            EE.REIMBURSABLE_AMOUNT * NVL(EE.EXCHANGE_RATE, 1)
            - NVL(APIL.AMOUNT, 0) * NVL(AIA.EXCHANGE_RATE, 1),
         2) AS DIFERENCIA_MONEDA_FUNCIONAL

        ,EE.TAX_CLASSIFICATION_CODE                CODIGO_DE_IMPUESTO_EXP

        -- === DIFERENCIA IMPUESTO ===
        ,CASE
            WHEN TIE.TASA IS NULL THEN NULL
            WHEN TIE.IMPUESTO_INCLUIDO = 'Y' THEN
                 ROUND(EE.REIMBURSABLE_AMOUNT * TIE.TASA / (100 + TIE.TASA), 2)
                 - ROUND(NVL((
                     SELECT SUM(ZXL.TAX_AMT)
                     FROM   ZX_LINES ZXL
                     WHERE  ZXL.APPLICATION_ID = 200
                       AND  ZXL.ENTITY_CODE = 'AP_INVOICES'
                       AND  ZXL.TRX_ID = APIL.INVOICE_ID
                       AND  ZXL.TRX_LINE_NUMBER = APIL.LINE_NUMBER
                 ), 0), 2)
            ELSE
                 ROUND(EE.REIMBURSABLE_AMOUNT * TIE.TASA / 100, 2)
                 - ROUND(NVL((
                     SELECT SUM(ZXL.TAX_AMT)
                     FROM   ZX_LINES ZXL
                     WHERE  ZXL.APPLICATION_ID = 200
                       AND  ZXL.ENTITY_CODE = 'AP_INVOICES'
                       AND  ZXL.TRX_ID = APIL.INVOICE_ID
                       AND  ZXL.TRX_LINE_NUMBER = APIL.LINE_NUMBER
                 ), 0), 2)
         END AS DIFERENCIA_IMPUESTO

        ,CCPG.COMBINACION_CONTABLE_EXP_TXT         COMBINACION_CONTABLE_EXP
        ,DAP.COMBINACION_CONTABLE_AP_TXT           COMBINACION_CONTABLE_AP

        -- === CÓDIGO DE IMPUESTO AP ===
        ,(SELECT MAX(ZXL.TAX_RATE_CODE)
          FROM ZX_LINES ZXL
          WHERE ZXL.APPLICATION_ID = 200
            AND ZXL.ENTITY_CODE = 'AP_INVOICES'
            AND ZXL.TRX_ID = APIL.INVOICE_ID
            AND ZXL.TRX_LINE_NUMBER = APIL.LINE_NUMBER
         ) AS CODIGO_DE_IMPUESTO_AP

        -- === DIFERENCIA CUENTA CONTABLE TXT ===
        ,DECODE(
            USERENV('LANGUAGE'),
            'AMERICAN', DECODE(
                CASE WHEN CCPG.CODE_COMBINATION_ID IS NOT NULL AND DAP.DIST_CODE_COMBINATION_ID IS NOT NULL AND CCPG.CODE_COMBINATION_ID != DAP.DIST_CODE_COMBINATION_ID THEN 'DIFERENTE'
                     WHEN CCPG.CODE_COMBINATION_ID IS NOT NULL AND DAP.DIST_CODE_COMBINATION_ID IS NULL THEN 'SIN_CUENTA_AP'
                     WHEN CCPG.CODE_COMBINATION_ID IS NULL AND DAP.DIST_CODE_COMBINATION_ID IS NOT NULL THEN 'SIN_CUENTA_EXP'
                     ELSE 'IGUAL'
                END,
                'DIFERENTE', 'Different',
                'SIN_CUENTA_AP', 'No AP Account',
                'SIN_CUENTA_EXP', 'No Expense Account',
                'Same'
            ),
            'PORTUGUESE', DECODE(
                CASE WHEN CCPG.CODE_COMBINATION_ID IS NOT NULL AND DAP.DIST_CODE_COMBINATION_ID IS NOT NULL AND CCPG.CODE_COMBINATION_ID != DAP.DIST_CODE_COMBINATION_ID THEN 'DIFERENTE'
                     WHEN CCPG.CODE_COMBINATION_ID IS NOT NULL AND DAP.DIST_CODE_COMBINATION_ID IS NULL THEN 'SIN_CUENTA_AP'
                     WHEN CCPG.CODE_COMBINATION_ID IS NULL AND DAP.DIST_CODE_COMBINATION_ID IS NOT NULL THEN 'SIN_CUENTA_EXP'
                     ELSE 'IGUAL'
                END,
                'DIFERENTE', 'Diferente',
                'SIN_CUENTA_AP', 'Sem Conta AP',
                'SIN_CUENTA_EXP', 'Sem Conta Despesa',
                'Igual'
            ),
            DECODE(
                CASE WHEN CCPG.CODE_COMBINATION_ID IS NOT NULL AND DAP.DIST_CODE_COMBINATION_ID IS NOT NULL AND CCPG.CODE_COMBINATION_ID != DAP.DIST_CODE_COMBINATION_ID THEN 'DIFERENTE'
                     WHEN CCPG.CODE_COMBINATION_ID IS NOT NULL AND DAP.DIST_CODE_COMBINATION_ID IS NULL THEN 'SIN_CUENTA_AP'
                     WHEN CCPG.CODE_COMBINATION_ID IS NULL AND DAP.DIST_CODE_COMBINATION_ID IS NOT NULL THEN 'SIN_CUENTA_EXP'
                     ELSE 'IGUAL'
                END,
                'DIFERENTE', 'Diferente',
                'SIN_CUENTA_AP', 'Sin Cuenta AP',
                'SIN_CUENTA_EXP', 'Sin Cuenta EXP',
                'Igual'
            )
         ) AS DIFERENCIA_CUENTA_CONTABLE_TXT

    FROM
         EXM_EXPENSE_REPORTS                     EER
        ,EXM_EXPENSES                            EE
        ,AP_INVOICES_ALL                         AIA
        ,AP_INVOICE_LINES_ALL                    APIL
        ,PROVEEDOR_POR_FACTURA                   PPF
        ,CUENTA_CONTABLE_POR_GASTO               CCPG
        ,PER_PERSON_NAMES_F                      PPNF
        ,HR_ALL_ORGANIZATION_UNITS_VL            HAOUV
        ,FUN_ALL_BUSINESS_UNITS_V                FABUV
        ,XLE_ENTITY_PROFILES                     XEP
        ,GL_LEDGERS                              GL
        ,EXM_EXPENSE_TYPES                       ET
        ,POZ_SUPPLIERS                           PS
        ,HZ_PARTIES                              HZP
        ,DISTRIBUCIONES_AP                       DAP
        ,TASAS_IMPUESTO_EXP                      TIE
        ,ESTADOS_EXPENSE_LOOKUP                  EXL
        ,ESTADOS_AP_LOOKUP                       APL
    WHERE
        EER.EXPENSE_REPORT_NUM = AIA.INVOICE_NUM(+)
        AND EER.ORG_ID = AIA.ORG_ID(+)
        AND EER.EXPENSE_REPORT_ID = EE.EXPENSE_REPORT_ID
        AND EE.EXPENSE_ID NOT IN (SELECT EXPENSE_ID_PADRE FROM LINEAS_PADRE_EXCLUIR)
        AND AIA.INVOICE_ID = APIL.INVOICE_ID(+)
        AND APIL.REFERENCE_KEY2(+) = TO_CHAR(EE.EXPENSE_ID)
        AND AIA.INVOICE_ID = PPF.INVOICE_ID(+)
        AND PPF.RN(+) = 1
        AND EE.EXPENSE_ID = CCPG.EXPENSE_ID(+)
        AND CCPG.RN(+) = 1
        AND EER.PERSON_ID = PPNF.PERSON_ID(+)
        AND PPNF.NAME_TYPE(+) = 'GLOBAL'
        AND TRUNC(SYSDATE) BETWEEN PPNF.EFFECTIVE_START_DATE(+) AND PPNF.EFFECTIVE_END_DATE(+)
        AND EER.ORG_ID = HAOUV.ORGANIZATION_ID
        AND HAOUV.NAME = FABUV.BU_NAME(+)
        AND TO_NUMBER(FABUV.PRIMARY_LEDGER_ID) = GL.LEDGER_ID(+)
        AND TO_NUMBER(FABUV.LEGAL_ENTITY_ID) = XEP.LEGAL_ENTITY_ID(+)
        AND TRUNC(SYSDATE) BETWEEN NVL(XEP.EFFECTIVE_FROM(+), TO_DATE('01/01/1900','DD/MM/YYYY'))
                                AND NVL(XEP.EFFECTIVE_TO(+), TO_DATE('31/12/4712','DD/MM/YYYY'))
        AND HAOUV.NAME IN ('ARCAF','CLID','PEBPE','PYBPY','UYBUY')
        AND (LEAST(:P_RAZON_SOCIAL) IS NULL OR XEP.NAME IN (:P_RAZON_SOCIAL))
        AND (LEAST(:P_UNIDAD_NEGOCIO) IS NULL OR HAOUV.NAME IN (:P_UNIDAD_NEGOCIO))
        AND TRUNC(EER.EXPENSE_REPORT_DATE) >= NVL(:P_FECHA_DESDE, TRUNC(EER.EXPENSE_REPORT_DATE))
        AND TRUNC(EER.EXPENSE_REPORT_DATE) <= NVL(:P_FECHA_HASTA, TRUNC(EER.EXPENSE_REPORT_DATE))
        AND (EER.EXPENSE_REPORT_NUM = NVL(:P_NUM_INFORME, EER.EXPENSE_REPORT_NUM) OR :P_NUM_INFORME IS NULL)
        AND EER.PERSON_ID = NVL(:P_COLABORADOR_ID, EER.PERSON_ID)
        AND EER.EXPENSE_STATUS_CODE = NVL(:P_ESTADO_EXPENSES, EER.EXPENSE_STATUS_CODE)
        AND (AIA.APPROVAL_STATUS = NVL(:P_ESTADO_AP, AIA.APPROVAL_STATUS) OR (:P_ESTADO_AP IS NULL AND AIA.APPROVAL_STATUS IS NULL))
        AND EE.EXPENSE_TYPE_ID = ET.EXPENSE_TYPE_ID(+)
        AND AIA.VENDOR_ID = PS.VENDOR_ID(+)
        AND NVL(PS.PARTY_ID, AIA.PARTY_ID) = HZP.PARTY_ID(+)
        AND APIL.INVOICE_ID = DAP.INVOICE_ID(+)
        AND APIL.LINE_NUMBER = DAP.INVOICE_LINE_NUMBER(+)
        AND DAP.RN(+) = 1
        AND EE.TAX_CLASSIFICATION_CODE = TIE.TAX_CLASSIFICATION_CODE(+)
        AND EER.EXPENSE_STATUS_CODE = EXL.LOOKUP_CODE(+)
        AND AIA.APPROVAL_STATUS = APL.LOOKUP_CODE(+)
)
SELECT
     RAZON_SOCIAL                          "Razón Social"
    ,UNIDAD_NEGOCIO                        "Unidad de Negocio"
    ,NOMBRE_DEL_EMPLEADO                   "Nombre del Empleado"
    ,NUM_INFORME_DE_GASTOS                 "Número Informe de Gastos"
    ,ESTADO_DEL_INFORME_TXT                "Estado del Informe"
    ,FECHA_DE_CREACION                     "Fecha de Creación"
    ,LINEA_DE_GASTO                        "Línea de Gasto"
    ,FECHA_DEL_GASTO_LINEA                 "Fecha del Gasto Línea"
    ,TIPO_DE_GASTO                         "Tipo de Gasto"
    ,DESCRIPCION_DEL_GASTO                 "Descripción del Gasto"
    ,NOMBRE_COMERCIANTE_PROVEEDOR_EXP      "Nombre Comerciante / Proveedor EXP"
    ,NUMERO_DE_FACTURA_AP                  "Número de Factura AP"
    ,PROVEEDOR_AP                          "Proveedor AP"
    ,ESTADO_FACTURA_AP_TXT                 "Estado Factura AP"
    ,FECHA_FACTURA_AP                      "Fecha Factura AP"
    ,FECHA_CONTABLE_AP                     "Fecha Contable AP"
    ,MONEDA_INTRODUCIDA_EXP                "Moneda Introducida EXP"
    ,SUBTOTAL_EXP_MONEDA_INTRODUCIDA       "Subtotal EXP Moneda Introducida"
    ,IMPORTE_TOTAL_EXP_MONEDA_INTRODUCIDA  "Importe Total EXP Moneda Introducida"
    ,SUBTOTAL_AP_MONEDA_INTRODUCIDA        "Subtotal AP Moneda Introducida"
    ,IMPORTE_TOTAL_AP_MONEDA_INTRODUCIDA   "Importe Total AP Moneda Introducida"
    ,DIFERENCIA_MONEDA_INTRODUCIDA         "Diferencia Moneda Introducida"
    ,TIPO_DE_CAMBIO                        "Tipo de Cambio"
    ,MONEDA_FUNCIONAL                      "Moneda Funcional"
    ,IMPORTE_TOTAL_EXP_MONEDA_FUNCIONAL    "Importe Total EXP Moneda Funcional"
    ,IMPORTE_TOTAL_AP_MONEDA_FUNCIONAL     "Importe Total AP Moneda Funcional"
    ,DIFERENCIA_MONEDA_FUNCIONAL           "Diferencia Moneda Funcional"
    ,CODIGO_DE_IMPUESTO_EXP                "Código de Impuesto EXP"
    ,IMPORTE_IMPUESTO_EXP                  "Importe Impuesto EXP"
    ,CODIGO_DE_IMPUESTO_AP                 "Código de Impuesto AP"
    ,IMPORTE_IMPUESTO_AP                   "Importe Impuesto AP"
    ,DIFERENCIA_IMPUESTO                   "Diferencia Impuesto"
    ,COMBINACION_CONTABLE_EXP              "Combinación Contable EXP"
    ,COMBINACION_CONTABLE_AP               "Combinación Contable AP"
    ,DIFERENCIA_CUENTA_CONTABLE_TXT        "Diferencia Cuenta Contable"
FROM BASE_DATOS